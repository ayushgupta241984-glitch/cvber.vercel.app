# CVBER Local Deployment Environment Variables

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=change-this-to-a-random-string

# Cloudflare Tunnel (for exposing your PC)
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# C2PA Signing (set to true if you have a C2PA certificate)
C2PA_SIGNING_ENABLED=false

# Mock mode (set to true for testing without AI keys)
MOCK_MODE=true

# Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,https://your-domain.sryze.cc